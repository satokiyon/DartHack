+nhCvtStringToColormap(dpy, args, num_args, fromVal, toVal, data)
+Display*        dpy;
+XrmValuePtr     args;
+Cardinal        *num_args;
+XrmValuePtr     fromVal;
+XrmValuePtr     toVal;
