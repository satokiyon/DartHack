+const char *
+jumpedthrough(ptr, def)
+const struct permonst *ptr;
+const char *def;
+{
+        return (
+            is_floater(ptr) ? levitate2 :
+            is_flyer(ptr)   ? fly2 :
+            slithy(ptr)     ? slither2 :
+            amorphous(ptr)  ? ooze2 :
+            nolimbs(ptr)    ? crawl2 :
+            def
+            );
