+void 
+jrndm_replace(c)
+     char *c;
+{
+    unsigned char cc[3];
+
+    if(IC==SJIS)
+      memcpy(cc, (char *)sj2e((unsigned char *)c), 2);
+    else
+      memcpy(cc, c, 2);
+
+    cc[0] &= 0x7f;
+    cc[1] &= 0x7f;
+
+    switch(cc[0]){
+      case 0x21:
+        cc[1] = rn2(94) + 0x21;
+        break;
+      case 0x23:
+        if(cc[1] <= 0x39) /* �O�`�X */
+          cc[1] = rn2(10) + 0x30;
+        else if(cc[1] <= 0x5A) /* �`�`�y */
+          cc[1] = rn2(26) + 0x41;
+        else if(cc[2] <= 0x7A) /* ���`�� */
+          cc[1] = rn2(26) + 0x61;
+        break;
+      case 0x24:
+      case 0x25:
+        cc[1] = rn2(83) + 0x21; /* ���`�� or �A�`�� */
+        break;
+      case 0x26:
+        if(cc[1] <= 0x30)
+          cc[1] = rn2(24) + 0x21; /* ���`�� �M���V������ */
+        else
+          cc[1] = rn2(24) + 0x41; /* ���`�� �M���V������ */
+        break;
+      case 0x27:
+        if(cc[1] <= 0x40)
+          cc[1] = rn2(33) + 0x21; /* �@�`�` ���V�A���� */
+        else
+          cc[1] = rn2(33) + 0x51; /* �p�`�� ���V�A���� */
+        break;
+      case 0x4f:
+        cc[1] = rn2(51) + 0x21; /* �@�` �r */
+        break;
+      case 0x74:
+        cc[1] = rn2(4) + 0x21; /* � � � � ��4����*/
+        break;
+      default:
+        if(cc[0] >= 0x30 && cc[1] <= 0x74)
+          cc[1] = rn2(94) + 0x21;
+        break;
+    }
+
+    cc[0] |= 0x80;
+    cc[1] |= 0x80;
+
+    if(IC==SJIS)
+      memcpy(c, (char *)e2sj(cc), 2);
+    else
+      memcpy(c, cc, 2);
+}
