+        p = (unsigned char *)&ro0[j << 2];
+    else if (j >= 0x0582 && j <= 0x1116)
+        p = (unsigned char *)&ro1[(j - 0x0582) << 2];
+    else if (j >= 0x1142 && j <= 0x1E7F)
+        p = (unsigned char *)&ro2[(j - 0x1142) << 2];
+    else p = (unsigned char *)"�H";
+    
+    if (p[2] != ' ' || p[3] != ' ') p += select_rnd * 2;
+    engr[nxt] = *p++;
+    engr[nxt + 1] = *p;
+
+    return 1;
