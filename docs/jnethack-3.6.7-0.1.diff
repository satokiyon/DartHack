+    unsigned char *p;
+#ifndef POSIX_ICONV
+    unsigned char *pp;
+#endif
+
+    if(!s)
+      return s;
+
+    buf[0] = '\0';
+
+    if( IC==input_kcode ){
+        strcpy((char *)buf, s);
+        return (char *)buf;
+    }
+
+    p = buf;
+#ifdef POSIX_ICONV
+    if (input_dsc) {
+        size_t src_len, dst_len;
+        up = (unsigned char *)s;
+        src_len = strlen(s);
+        dst_len = sizeof(buf);
+        if (iconv(input_dsc, (char**)&up, &src_len,
+                (char**)&p, &dst_len) == (size_t)-1){
+            strcpy((char *)buf, s);
+            return (char *)buf;
+        }
+        *(p++) = '\0';
+        return (char *)buf;
+    } else {
+        strcpy((char *)buf, s);
+        return (char *)buf;
+    }
+#else
+    if( IC==EUC && input_kcode == SJIS ){
+        while(*s){
+            up = (unsigned char *)s;
+            if(is_kanji(*up)){
+                pp = sj2e((unsigned char *)s);
+                *(p++) = pp[0];
+                *(p++) = pp[1];
+                s += 2;
+            }
+            else
+              *(p++) = (unsigned char)*(s++);
+        }
+        *(p++) = '\0';
+        return (char *)buf;
+    } else {
+        strcpy((char *)buf, s);
+        return (char *)buf;
+    }
+#endif
+
