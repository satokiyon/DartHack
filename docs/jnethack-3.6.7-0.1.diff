+/*
+**      EUC->SJIS
+*/
+
+unsigned char *
+e2sj(s)
+     unsigned char *s;
+{
+    unsigned char h,l;
+    static unsigned char sw[2];
+
+    h = s[0] & 0x7f;
+    l = s[1] & 0x7f;
+
+    sw[0] = ((h - 1) >> 1)+ ((h <= 0x5e) ? 0x71 : 0xb1);
+    sw[1] = l + ((h & 1) ? ((l < 0x60) ? 0x1f : 0x20) : 0x7e);
+
+    return sw;
+}
+/*
+**      SJIS->EUC
+*/
+unsigned char *
+sj2e(s)
+     unsigned char *s;
+{
+    unsigned int h,l;
+    static unsigned char sw[2];
+
+    h = s[0];
+    l = s[1];
+
+    h = h + h - ((h <=0x9f) ? 0x00e1 : 0x0161);
+    if( l<0x9f )
+      l = l - ((l > 0x7f) ? 0x20 : 0x1f);
+    else{
+        l = l-0x7e;
+        ++h;
+    }
+    sw[0] = h | 0x80;
+    sw[1] = l | 0x80;
+    return sw;
+}
