 SOUND=MSG "(ベル|開門のベル)を鳴らした\." "sound_Bell.wav" 100
 
# 地震の太鼓
SOUND=MSG "重く雷鳴のような轟きを響かせた!|周囲の.*が揺れている!" "sound_Drum_Of_Earthquake.wav" 100
 
# 火の角笛・氷の角笛
SOUND=MSG "角笛から炎が噴き出した!" "sound_Fire_Horn.wav" 100
SOUND=MSG "角笛から冷気が噴き出した!" "sound_Frost_Horn.wav" 100
 
# 革太鼓
SOUND=MSG "耳をつんざく騒音をたたき出した!|を(叩き損ねた|何とか刻んだ|見事に刻んだ)" "sound_Leather_Drum.wav" 100



### sepack 効果音セット（sepackフォルダのwavファイルをゲームメッセージに対応させる設定）
# ---- 04: 選択音（低い音）・05: 選択音（高い音）・06: メッセージ送り・07: エラー音 ----
# UIイベントはSOUND=MSGで対応できないため設定なし

# ---- 08: 階段を使う音 ----
SOUND=MSG "階段を(上|下|登|降)った.|はしごを(上|下|登|降)った." "sepack/sepack_08_stairs.wav" 100
SOUND=MSG "はしごから落ちた.|階段から落ちた." "sepack/sepack_08_stairs.wav" 100

# ---- 09: ドアを開ける音 ----
SOUND=MSG "扉を蹴ると、(粉々に砕け散|激しく開い)た[!。.]" "sepack/sepack_09_open_door.wav" 100
SOUND=MSG "扉が破壊された[!！]" "sepack/sepack_09_open_door.wav" 100
SOUND=MSG "壁に扉が現れた[!！]" "sepack/sepack_09_open_door.wav" 100

# ---- 10: ワープ音1 ----
SOUND=MSG "謎の力が一瞬あなたを包んだ" "sepack/sepack_10_warp_1.wav" 100
SOUND=MSG "テレポートし" "sepack/sepack_10_warp_1.wav" 100
SOUND=MSG "(が|は)消えた[!！]" "sepack/sepack_10_warp_1.wav" 100

# ---- 11: ワープ音2（別の消え方・現れ方） ----
SOUND=MSG "突然.+が現れた[!！]" "sepack/sepack_11_warp_2.wav" 100
SOUND=MSG "が現れた[.。]" "sepack/sepack_11_warp_2.wav" 100

# ---- 12: ダメージ床 ----
SOUND=MSG "地雷が爆発した[!！]" "sepack/sepack_12_damage_floor.wav" 100
SOUND=MSG "棘だらけの落とし穴" "sepack/sepack_12_damage_floor.wav" 100
SOUND=MSG "ここの溶岩があなたを焼いた[!！]" "sepack/sepack_12_damage_floor.wav" 100
SOUND=MSG "落とし穴へ(落ちた|つまずいて落ちた)" "sepack/sepack_12_damage_floor.wav" 100

# ---- 13: 警報 ----
SOUND=MSG "警報が鳴り響いた[!！]" "sepack/sepack_13_alarm.wav" 100

# ---- 14: 打撃音1（斬りつけるイメージ） ----
SOUND=MSG "切りつける|斬りつけ" "sepack/sepack_14_slash.wav" 100

# ---- 15: 打撃音2（ダメージを食らうイメージ） ----
SOUND=MSG "爆発した[!！]" "sepack/sepack_15_damage.wav" 100
SOUND=MSG "を受けた[!！]|で傷つい" "sepack/sepack_15_damage.wav" 100
SOUND=MSG "はあなたを噛んだ[!！]|を叩いた[!！]|をかじった[!！]" "sepack/sepack_15_damage.wav" 100

# ---- 16: 打撃音3（叩くイメージ、高めの音） ----
SOUND=MSG "ビヨンッ[!！]" "sepack/sepack_16_hit_high.wav" 100
SOUND=MSG "は弾き飛ばされた[!！]" "sepack/sepack_16_hit_high.wav" 100

# ---- 17: 打撃音4（叩くイメージ、低めの音） ----
SOUND=MSG "ガシャーン[!！]" "sepack/sepack_17_hit_low.wav" 100
SOUND=MSG "ドスン|ズドン" "sepack/sepack_17_hit_low.wav" 100

# ---- 18: 打撃音5（激しめの音） ----
SOUND=MSG "ドカーン[!！][!！]" "sepack/sepack_18_hit_hard.wav" 100

# ---- 19: 弓矢を放つ・投げる音 ----
SOUND=MSG "を投げた[.。]" "sepack/sepack_19_shoot_throw.wav" 100
SOUND=MSG "素手の.+を投げた" "sepack/sepack_19_shoot_throw.wav" 100

# ---- 20: 放ったものが当たる音 ----
SOUND=MSG "があなたに命中した[!！]" "sepack/sepack_20_hit_missile.wav" 100
SOUND=MSG "光線があなたに命中した[!！]" "sepack/sepack_20_hit_missile.wav" 100

# ---- 21: 爆発音1（低い音） ----
SOUND=MSG "爆発音が聞こえた[.。]" "sepack/sepack_21_explosion_low.wav" 100
SOUND=MSG "遠くで爆発音が" "sepack/sepack_21_explosion_low.wav" 100

# ---- 22: 爆発音2（高い音） ----
SOUND=MSG "魔法の爆発に巻き込まれた[!！]" "sepack/sepack_22_explosion_high.wav" 100
SOUND=MSG "薬瓶が爆発した[!！]" "sepack/sepack_22_explosion_high.wav" 100
SOUND=MSG "が爆発した[!！]" "sepack/sepack_22_explosion_high.wav" 100

# ---- 23: 逃走 ----
SOUND=MSG "は(上|下)の階へ逃げた[!！]" "sepack/sepack_23_escape.wav" 100
SOUND=MSG "は(はしごを|階段を)(上|下)(って|りて)逃げた[!！]" "sepack/sepack_23_escape.wav" 100
SOUND=MSG "から逃げ出した[!！]" "sepack/sepack_23_escape.wav" 100

# ---- 24: ブレス攻撃1（炎・毒ガス等） ----
SOUND=MSG "火炎の息|炎の息" "sepack/sepack_24_breath_1.wav" 100
SOUND=MSG "毒ガスの息|睡眠ガスの息" "sepack/sepack_24_breath_1.wav" 100
SOUND=MSG "角笛から炎が噴き出した[!！]" "sepack/sepack_24_breath_1.wav" 100

# ---- 25: ブレス攻撃2（氷・電撃・分解等） ----
SOUND=MSG "氷結の息|冷気の息" "sepack/sepack_25_breath_2.wav" 100
SOUND=MSG "電撃の息|分解の息|酸の息" "sepack/sepack_25_breath_2.wav" 100
SOUND=MSG "角笛から冷気が噴き出した[!！]" "sepack/sepack_25_breath_2.wav" 100

# ---- 26: 電撃 ----
SOUND=MSG "電撃を受けた[!！]|感電した" "sepack/sepack_26_lightning.wav" 100
SOUND=MSG "電撃でしびれた[!！]" "sepack/sepack_26_lightning.wav" 100
SOUND=MSG "稲妻が上空から" "sepack/sepack_26_lightning.wav" 100
SOUND=MSG "あなたの体に.+電撃が走った[!！]" "sepack/sepack_26_lightning.wav" 100

# ---- 27: 氷・冷気 ----
SOUND=MSG "凍りついた[!！]" "sepack/sepack_27_ice.wav" 100
SOUND=MSG "その場で凍りついた[!！]" "sepack/sepack_27_ice.wav" 100
SOUND=MSG "から凍りつく霧が立ちのぼり" "sepack/sepack_27_ice.wav" 100

# ---- 28: 呪文詠唱 ----
SOUND=MSG "は呪文を唱えた[!！]" "sepack/sepack_28_cast_spell.wav" 100
SOUND=MSG "に呼びかけ、神秘的な呪文を唱えた" "sepack/sepack_28_cast_spell.wav" 100
SOUND=MSG "巻物の呪文を唱えた" "sepack/sepack_28_cast_spell.wav" 100

# ---- 29: ターゲッティング ----
SOUND=MSG "をターゲットにし|を狙っ" "sepack/sepack_29_target.wav" 100
SOUND=MSG "あなたを狙った.*光線が" "sepack/sepack_29_target.wav" 100
SOUND=MSG "魔法の杖の光線があなたに命中した[!！]" "sepack/sepack_29_target.wav" 100

# ---- 30: 呪文・魔法汎用1 ----
