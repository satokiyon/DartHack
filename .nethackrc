SOUND=MSG "(ファ#♪)" "se_squeak_F_sharp.wav" 100
SOUND=MSG "(ソ♪)" "se_squeak_G.wav" 100
SOUND=MSG "(ソ#♪)" "se_squeak_G_sharp.wav" 100
